# PECE Docker Compose — environment variables
# Copy this file to /opt/pece2/.env on the VPS and fill in real values.
# The deploy script writes this file automatically from GitHub Actions secrets.

# Image tags — set to a specific sha-<short> tag for pinned deploys
PHP_IMAGE=ghcr.io/pece-project/drupal-pece/php:latest
NGINX_IMAGE=ghcr.io/pece-project/drupal-pece/nginx:latest

# MariaDB credentials
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Drupal trusted host pattern — must match the domain Easypanel routes to this app.
# Regex syntax. Examples:
#   pece.example.com      → ^pece\.example\.com$
#   Wildcard subdomain    → ^.*\.example\.com$
DRUPAL_TRUSTED_HOST=^localhost$
